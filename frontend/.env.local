# Local Development Environment - For OTP Testing
# This file is used when running: npm start locally
# To use this, rename to .env.local or just run npm start (it will use this automatically)

# API Configuration - Points to LOCAL backend to see OTP in console
REACT_APP_API_URL=http://localhost:5000/api

# Suppress webpack dev server warnings
DISABLE_ESLINT_PLUGIN=true
SKIP_PREFLIGHT_CHECK=true
WDS_SOCKET_PORT=0
